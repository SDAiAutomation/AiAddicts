{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m unittest:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python -m growthos.engine.story_animation.benchmark_rig_v2:*)",
      "Bash(python -m growthos.engine.story_animation.benchmark_measured_rig_v2:*)",
      "Bash(python3 -m growthos.engine.story_animation.benchmark_rig_v2:*)",
      "Bash(python3 -m growthos.engine.story_animation.benchmark_measured_rig_v2:*)",
      "Bash(ffprobe:*)",
      "Bash(ffmpeg:*)",
      "Bash(sha256sum:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(node --test:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Read(./.env)",
      "Read(./growthos/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\""
          }
        ]
      }
    ]
  }
}
