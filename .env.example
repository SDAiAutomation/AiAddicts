# Ollama (local inference server)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=mistral
EMBEDDING_MODEL=nomic-embed-text

# SharePoint / Microsoft Graph API
# Required only for Phase 2 (SharePoint integration)
SP_TENANT_ID=your-tenant-id-here
SP_CLIENT_ID=your-app-client-id-here
SP_CLIENT_SECRET=your-app-client-secret-here
SP_SITE_URL=https://alstomgroup.sharepoint.com/sites/CRL-Methodes
SP_LIBRARY_NAME=Fiches d'Instructions

# RAG tuning
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_K=4

# Conformity threshold (0-100) above which a FI is considered "Conforme"
CONFORMITY_THRESHOLD=70
