    {
      "role": "point",
      "text": "Then manage the remaining $2,400.",
      "visual": "A sequence showing income, then savings taken out, then what's left to spend.",
      "motion_graphic": {
        "sceneType": "compound_growth",
        "title": "Where the $3,000 goes",
        "data": [
          {"label": "Income", "displayValue": "$3,000"},
          {"label": "Saved first", "displayValue": "$600"},
          {"label": "Available to spend", "displayValue": "$2,400"}
