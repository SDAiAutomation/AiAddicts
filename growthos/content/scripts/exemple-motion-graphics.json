      "motion_graphic": {
        "sceneType": "big_number",
        "title": "Monthly income",
        "displayValue": "$3,000",
        "value": 3000,
        "label": "Don't wait until month-end to save",
        "icon": "wallet"
      }
    },
    {
      "role": "point",
      "text": "Move your savings first.",
      "visual": "An icon representing savings, with the instruction as text.",
      "motion_graphic": {
        "sceneType": "icon_text",
        "icon": "piggy_bank",
        "text": "Move your savings first"
      }
    },
    {
      "role": "point",
      "text": "For example, put $600 aside immediately.",
      "visual": "A big animated number showing the amount saved first.",
      "motion_graphic": {
        "sceneType": "big_number",
        "displayValue": "$600",
        "value": 600,
        "label": "Savings first",
        "icon": "piggy_bank"
