      "motion_graphic": {
        "sceneType": "formula",
        "title": "The rule",
        "terms": ["INCOME", "- SAVINGS", "= SPENDING BUDGET"]
      }
    },
    {
      "role": "cta",
      "text": "Save first. Spend what's left. Follow for more simple money rules.",
      "visual": "A takeaway card with the core rule as a checklist.",
      "motion_graphic": {
        "sceneType": "checklist",
