ELEVENLABS_API_KEY=ta_cle_elevenlabs

# Visuels de bloc — gratuit, cle sur pexels.com/api. Sert aux clips video de
# stock (visual_style=stock_footage) ET au repli photo. Optionnel : sans cle,
# retombe sur les images IA puis le fond couleur unie.
PEXELS_API_KEY=

# Nombre de blocs par image IA (defaut 1 = une image par bloc). Mettre 3 pour
# regrouper et diviser le cout OpenAI.
VISUALS_BLOCKS_PER_IMAGE=1

# Images IA des scenes (engine/openai_images.py). Meme cle que la generation
# de script cote growthos-web. Optionnel : sans cle -> Pexels puis fond uni.
OPENAI_API_KEY=
# Modele image (defaut gpt-image-2.5-flare) : rapide, meilleure adherence au prompt,
# aux personnages recurrents et au style visuel.
# Repli legacy pour le mode "final" (engine/image_model_router.py) si
# IMAGE_MODEL_PREMIUM/IMAGE_FINAL_QUALITY ne sont pas renseignes.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# low | medium | high (defaut medium). "high" est plus lent et plus couteux :
# reserve aux histoires illustrees / personnages.
OPENAI_IMAGE_QUALITY=medium

# --- Routage modele par usage (engine/image_model_router.py) -----------------
# Tous optionnels : sans rien renseigner ici, le mode "final" (seul utilise
# aujourd'hui par le pipeline) retombe EXACTEMENT sur OPENAI_IMAGE_MODEL/
# OPENAI_IMAGE_QUALITY ci-dessus -- aucun changement de cout par defaut.
# IMAGE_MODEL_FAST=gpt-image-2.5-flare    # mode "preview", qualite low
# IMAGE_MODEL_PREMIUM=gpt-image-2.5-flare # mode "final"
# IMAGE_MODEL_EDIT=gpt-image-2.5-flare    # mode "edit" (correction ciblee)
# IMAGE_PREVIEW_QUALITY=low
# IMAGE_FINAL_QUALITY=high
# IMAGE_EDIT_QUALITY=high

# --- Suivi de cout par generation (content_items.generation_cost_report) -------
# Tarifs en $ ; a lire sur ta facturation OpenAI / ElevenLabs (pas de valeur par
# defaut : ils changent). Sans eux, les volumes (tokens, caracteres) sont quand
# meme enregistres et `missingRates` indique ce qui manque.
# IMAGE_PRICE_IMAGE_OUT_PER_M=    # $ / million de tokens image en sortie
# IMAGE_PRICE_TEXT_IN_PER_M=      # $ / million de tokens texte en entree
# IMAGE_PRICE_IMAGE_IN_PER_M=     # $ / million de tokens image en entree (edits)
# ELEVENLABS_USD_PER_1K_CHARS=    # $ / 1000 caracteres selon ton forfait
# SCRIPT_PRICE_IN_PER_M=          # $ / million de tokens entree, modele de script (OPENAI_SCRIPT_MODEL du front)
# SCRIPT_PRICE_OUT_PER_M=         # $ / million de tokens sortie, idem

# --- Controle qualite vision (engine/image_quality_control.py) ---------------
# NOUVELLE capacite, OPT-IN : ajoute un appel reseau + un cout + de la latence
# par image generee. Reste desactivee tant que IMAGE_QC_ENABLED n'est pas mis
# a true -- verifie le modele/le cout avant d'activer sur un environnement de
# production.
IMAGE_QC_ENABLED=false
# Modele vision a utiliser pour la QC -- PAS de defaut code en dur, a verifier
# sur ton compte OpenAI (Chat Completions, entree image + JSON en sortie).
IMAGE_QC_MODEL=
# IMAGE_QC_THRESHOLD_APPROVE=85   # score >= -> image approuvee
# IMAGE_QC_THRESHOLD_EDIT=70      # score >= -> correction ciblee (/edits) ; en dessous -> regeneration complete
# MAX_IMAGE_ATTEMPTS=3            # plafond generate/edit->QC->decision avant "needs_manual_review"

# --- Diagnostic d'originalite / anti-repetition (engine/originality.py) ------
# NOUVELLE capacite, OPT-IN : compare le script aux ~20 dernieres videos du
# compte (concept, personnage, situation, hook...). Ajoute un appel reseau + un
# cout par generation. Seuils non calibres sur un corpus annote -- diagnostic,
# jamais une certification de doublon ni de l'eligibilite a la monetisation.
ORIGINALITY_CHECK_ENABLED=false
# Modele texte a utiliser -- PAS de defaut code en dur, a verifier sur ton
# compte OpenAI (Chat Completions, JSON en sortie).
ORIGINALITY_MODEL=
# ORIGINALITY_HISTORY_LIMIT=20    # nombre max de videos passees comparees
# ORIGINALITY_THRESHOLD_BLOCK=90  # score de ressemblance >= -> "quality_check" (revue)
# ORIGINALITY_THRESHOLD_WARN=70   # score >= -> avertissement seul, statut inchange
# ORIGINALITY_PRICE_IN_PER_M=     # $ / million de tokens entree, modele ORIGINALITY_MODEL
# ORIGINALITY_PRICE_OUT_PER_M=    # $ / million de tokens sortie, idem

# AutoEdit (montage automatique de clips) -- EXPERIMENTAL, infrastructure seule.
# Desactive par defaut : le worker ne traite pas la file autoedit_jobs. Tant
# qu'aucune analyse video reelle n'est branchee, le resultat est SIMULE (aucun
# appel payant, aucune video produite) et se declare comme tel. Aucun appel
# Vision payant ne doit etre active avant un benchmark sur des videos reelles.
AUTOEDIT_ENABLED=false
# AUTOEDIT_ANALYZER=signals      # analyse locale FFmpeg + rendu réel ; simulated pour le smoke test
# AUTOEDIT_CREDIT_COST=1         # credits par job pour un analyseur REEL (provisoire, non mesure)
# AUTOEDIT_MUSIC=on              # musique Eleven Music si un rush sport est muet
# AUTOEDIT_SILENCE_DB=-45         # seuil de piste quasi muette
# AUTOEDIT_MUSIC_USD_PER_MIN=     # coût contractuel réel ; vide = inconnu
# AUTOEDIT_SCRIBE_USD_PER_HOUR=   # coût contractuel réel ; vide = inconnu

# Supabase (projet dedie "growthos", ref lclesqfokgetznhepgmj)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend uniquement (jobs, ecriture audit.events, credits). Jamais commite,
# jamais expose cote client. A recuperer sur le dashboard Supabase :
# Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
# Garde-fous de cout (engine/script.py, engine/assembler.py). Les plafonds ont des
# defauts (20 blocs, 3000 caracteres) ; le seuil d'alerte n'en a pas : fixe-le
# d'apres le cout moyen mesure (ex. 1.5x la moyenne) — voir la vue SQL
# generation_cost_weekly.
# MAX_SCRIPT_BLOCKS=20
# MAX_SCRIPT_CHARS=3000
# GENERATION_COST_ALERT_USD=
