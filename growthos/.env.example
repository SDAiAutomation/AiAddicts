ELEVENLABS_API_KEY=ta_cle_elevenlabs

# Visuels de bloc — gratuit, cle sur pexels.com/api. Sert aux clips video de
# stock (visual_style=stock_footage) ET au repli photo. Optionnel : sans cle,
# retombe sur les images IA puis le fond couleur unie.
PEXELS_API_KEY=

# Nombre de blocs par image IA (defaut 1 = une image par bloc). Mettre 3 pour
# regrouper et diviser le cout OpenAI.
VISUALS_BLOCKS_PER_IMAGE=1

# Images IA des scenes (engine/openai_images.py). Meme cle que la generation
# de script cote growthos-web. Optionnel : sans cle -> Pexels puis fond uni.
OPENAI_API_KEY=
# Modele image (defaut gpt-image-1-mini). "gpt-image-1" = meilleure adherence
# au prompt / meilleure coherence des personnages, ~x3-4 le cout.
# Repli legacy pour le mode "final" (engine/image_model_router.py) si
# IMAGE_MODEL_PREMIUM/IMAGE_FINAL_QUALITY ne sont pas renseignes.
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# low | medium | high (defaut medium, ~0,03 $/image en mini). "high" ~0,06 $
# et ~30-60 s par appel : reserve aux histoires illustrees / personnages.
OPENAI_IMAGE_QUALITY=medium

# --- Routage modele par usage (engine/image_model_router.py) -----------------
# Tous optionnels : sans rien renseigner ici, le mode "final" (seul utilise
# aujourd'hui par le pipeline) retombe EXACTEMENT sur OPENAI_IMAGE_MODEL/
# OPENAI_IMAGE_QUALITY ci-dessus -- aucun changement de cout par defaut.
# IMAGE_MODEL_FAST=gpt-image-1-mini       # mode "preview" (pas encore branche par defaut)
# IMAGE_MODEL_PREMIUM=gpt-image-1         # mode "final" -- change le cout si renseigne
# IMAGE_MODEL_EDIT=gpt-image-1            # mode "edit" (correction ciblee) -- defaut deja gpt-image-1
# IMAGE_PREVIEW_QUALITY=low
# IMAGE_FINAL_QUALITY=high
# IMAGE_EDIT_QUALITY=high

# --- Controle qualite vision (engine/image_quality_control.py) ---------------
# NOUVELLE capacite, OPT-IN : ajoute un appel reseau + un cout + de la latence
# par image generee. Reste desactivee tant que IMAGE_QC_ENABLED n'est pas mis
# a true -- verifie le modele/le cout avant d'activer sur un environnement de
# production.
IMAGE_QC_ENABLED=false
# Modele vision a utiliser pour la QC -- PAS de defaut code en dur, a verifier
# sur ton compte OpenAI (Chat Completions, entree image + JSON en sortie).
IMAGE_QC_MODEL=
# IMAGE_QC_THRESHOLD_APPROVE=85   # score >= -> image approuvee
# IMAGE_QC_THRESHOLD_EDIT=70      # score >= -> correction ciblee (/edits) ; en dessous -> regeneration complete
# MAX_IMAGE_ATTEMPTS=3            # plafond generate/edit->QC->decision avant "needs_manual_review"

# Supabase (projet dedie "growthos", ref lclesqfokgetznhepgmj)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend uniquement (jobs, ecriture audit.events, credits). Jamais commite,
# jamais expose cote client. A recuperer sur le dashboard Supabase :
# Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
